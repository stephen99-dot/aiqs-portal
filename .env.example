# AI QS Portal — environment variables
#
# Copy to .env and fill in what you need. .env is gitignored.
# Values are omitted on purpose: this file documents the names and what they do,
# it is not a place to keep secrets.
#
# Nothing here is required to run the test suite (`npm test`) or the eval harness.
# The server starts without most of it; the features behind each key are simply
# unavailable. The two secrets marked MUST SET fall back to hardcoded defaults
# and are unsafe in production.

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=                        # HTTP port for the API server. Default 3001.
NODE_ENV=                    # 'production' enables prod-only behaviour (secure cookies etc).
JWT_SECRET=                  # MUST SET. Signs auth tokens. Falls back to a known literal.
WEBHOOK_SECRET=              # MUST SET. Shared secret for inbound webhooks. Same problem.
PORTAL_URL=                  # Public base URL, used in emails and links.
PORTAL_BASE_URL=             # Same, used by other modules. Set both to the same value.

# ── Anthropic (chat, takeoff, BOQ generation) ────────────────────────────────
ANTHROPIC_API_KEY=           # Required for anything AI-driven.
USE_BATCH_API=               # '1' routes eligible single calls through the Batch API (~50% cheaper, slower).
AGENTIC_TAKEOFF=             # '1' enables the agentic plan/measure/verify takeoff loop on complex jobs.
ENABLE_WEB_SEARCH=           # '0' disables the model's web-search tool. Any other value leaves it on.
STRICT_RECALC=               # '1' makes the recalculation gate hard-fail instead of warning.
RATE_PROMPT_CAP=             # Max client rates injected into a prompt. Default 1200.

# ── Voyage (embeddings for semantic rate/memory lookup) ──────────────────────
VOYAGE_API_KEY=              # Without this, retrieval falls back to FTS5 keyword search.
VOYAGE_MODEL=                # Embedding model. Default 'voyage-3-lite'.

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=                   # SMTP server hostname.
SMTP_PORT=                   # SMTP port.
SMTP_USER=                   # SMTP username.
SMTP_EMAIL=                  # Sending address, when it differs from SMTP_USER.
SMTP_PASS=                   # SMTP password. Takes precedence over SMTP_PASSWORD.
SMTP_PASSWORD=               # Legacy alias for SMTP_PASS. Prefer SMTP_PASS.
MAIL_FROM=                   # From address on outbound mail. Defaults to the SMTP user.
FROM_EMAIL=                  # From address for transactional sends.
SENDGRID_API_KEY=            # Alternative to SMTP. If set, SendGrid is used instead.

# ── Stripe (payments, subscriptions, Connect) ────────────────────────────────
STRIPE_SECRET_KEY=           # Server-side Stripe key.
STRIPE_WEBHOOK_SECRET=       # Verifies Stripe webhook signatures.
STRIPE_CONNECT_WEBHOOK_SECRET=  # Same, for Connect (subaccount) events.
STRIPE_BOQ_PACKS=            # Price IDs for BOQ credit packs.
STRIPE_OFFICE_PRICE_IDS=     # Price IDs for the Office product. Comma-separated.
STRIPE_OFFICE_PRICE_ID=      # Single-price fallback if STRIPE_OFFICE_PRICE_IDS is unset.

# ── Xero (accounting sync) ───────────────────────────────────────────────────
XERO_CLIENT_ID=              # OAuth2 app client ID.
XERO_CLIENT_SECRET=          # OAuth2 app client secret.
XERO_REDIRECT_URI=           # OAuth2 callback. Must match the Xero app config exactly.

# ── Google (Drive / OAuth) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=            # OAuth2 client ID.
GOOGLE_CLIENT_SECRET=        # OAuth2 client secret.
DRIVE_LINK_WEBHOOK_SECRET=   # Shared secret for the Drive link webhook.

# ── PlanIt (planning application data) ───────────────────────────────────────
PLANIT_API_KEY=              # PlanIt API key.
PLANIT_AUTH_PARAM=           # Query-param name carrying the key. Default 'auth'.
PLANIT_CONTACT_EMAIL=        # Contact address sent with requests, per PlanIt's fair-use ask.

# ── Material price scraping (server/scrapeMaterials.js, twice-weekly in CI) ───
SCRAPER_API_KEY=             # ScraperAPI key. Without it, scraping runs direct and gets blocked more.
SCRAPER_API_BASE=            # ScraperAPI endpoint. Default 'http://api.scraperapi.com/'.
SCRAPER_RENDER=              # Pass-through render flag for JS-heavy merchant pages.
DISCOVER_SUPPLIERS=          # Merchants to scrape. Default 'toolstation,screwfix,wickes,bandq'.
DISCOVER_LIMIT=              # Max products per run. Default 120.
SUPPLIERS_PER_MATERIAL=      # Price quotes to gather per material. Default 2.
RETRY_FAILED_AFTER_DAYS=     # Days before retrying a product that failed to scrape. Default 21.

# ── Pipedream (external automation hooks) ────────────────────────────────────
PIPEDREAM_MAIN_WEBHOOK=      # Primary event webhook.
PIPEDREAM_FILE_WEBHOOK=      # File-upload event webhook.
PIPEDREAM_WEBHOOK_URL=       # Generic fallback webhook.

# ── Frontend (baked in at build time by react-scripts) ───────────────────────
REACT_APP_API_URL=           # API base URL. Empty means same-origin.
REACT_APP_OFFICE_PAYMENT_LINK=  # Stripe payment link for the Office upsell page.

# ── Injected by Render at deploy time — do not set these yourself ────────────
# RENDER_GIT_BRANCH          # Branch that produced the running build.
# RENDER_GIT_COMMIT          # Commit SHA of the running build.
# RENDER_SERVICE_NAME        # Render service name.
