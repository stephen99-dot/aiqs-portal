<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: portal URLs (magic links, quotes, invoices, projects)
                 open in the app once /.well-known/assetlinks.json is live on the
                 host (server/appLinks.js, ANDROID_SHA256_CERT). Change the host
                 here if the portal moves to a custom domain. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="aiqs-portal.onrender.com" android:pathPrefix="/magic" />
                <data
                    android:scheme="https"
                    android:host="aiqs-portal.onrender.com"
                    android:pathPrefix="/team-invite"
                />
                <data android:scheme="https" android:host="aiqs-portal.onrender.com" android:pathPrefix="/v/" />
                <data android:scheme="https" android:host="aiqs-portal.onrender.com" android:pathPrefix="/q/" />
                <data android:scheme="https" android:host="aiqs-portal.onrender.com" android:pathPrefix="/i/" />
                <data android:scheme="https" android:host="aiqs-portal.onrender.com" android:pathPrefix="/project/" />
                <data android:scheme="https" android:host="aiqs-portal.onrender.com" android:path="/dashboard" />
                <data android:scheme="https" android:host="aiqs-portal.onrender.com" android:path="/chat" />
                <data android:scheme="https" android:host="aiqs-portal.onrender.com" android:path="/submit-drawings" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- <input type="file" accept="image/*"> offers the camera when this is declared. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
