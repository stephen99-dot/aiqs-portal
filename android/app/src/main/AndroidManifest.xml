<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: portal links open in the app. Android checks
                 https://<host>/.well-known/assetlinks.json (server/appLinks.js,
                 needs ANDROID_CERT_SHA256 set on the portal). Change the host
                 here if the portal moves to a custom domain. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="aiqs-portal.onrender.com" />
                <data android:pathPrefix="/magic" />
                <data android:pathPrefix="/team-invite" />
                <data android:pathPrefix="/auth/google/success" />
                <data android:pathPrefix="/payment-success" />
                <data android:pathPrefix="/v/" />
                <data android:pathPrefix="/q/" />
                <data android:pathPrefix="/i/" />
                <data android:pathPrefix="/project/" />
                <data android:pathPrefix="/dashboard" />
                <data android:pathPrefix="/submit-drawings" />
                <data android:pathPrefix="/chat" />
            </intent-filter>
        </activity>

        <!-- Push: small monochrome icon and accent colour for the status bar,
             and the channel "job ready" notifications are posted to. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify"
        />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent"
        />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="jobs" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ asks the user before an app may post notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
