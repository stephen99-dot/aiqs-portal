{
  "name": "aiqs-app",
  "version": "1.0.0",
  "description": "AI QS — Customer Portal for AI-Powered Quantity Surveying",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "react-scripts start",
    "build": "react-scripts build",
    "start": "node server/index.js",
    "scrape:materials": "node server/scrapeMaterials.js",
    "test": "node --test \"server/**/*.test.js\"",
    "ios:assets": "node scripts/build-app-icons.js && capacitor-assets generate --ios --splashBackgroundColor \"#F5F7FA\" --splashBackgroundColorDark \"#141C2E\"",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios": "npm run ios:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "concurrently": "^9.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.4.7",
    "dxf-parser": "^1.1.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.263.1",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.0",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.1.1",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.33.4",
    "stripe": "^14.0.0",
    "three": "^0.160.1",
    "uuid": "^11.0.3",
    "xlsx": "^0.18.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "proxy": "http://localhost:3001",
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
